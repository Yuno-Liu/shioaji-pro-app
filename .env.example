# ── Shioaji credentials ──────────────────────────────────────────────
# Required by `shioaji server start` (the CLI reads .env from this dir).
# Create your API key / secret key at:
#   https://www.sinotrade.com.tw/newweb/PythonAPIKey/
# Copy this file to `.env` and fill in your keys. NEVER commit `.env`.
SJ_API_KEY=your_api_key_here
SJ_SEC_KEY=your_secret_key_here

# The server runs in SIMULATION mode by default (paper trading).
# Only set this to true when you are ready for real trading — it also
# requires your CA certificate (SJ_CA_PATH / SJ_CA_PASSWD).
# SJ_PRODUCTION=true

# ── Frontend (optional) ──────────────────────────────────────────────
# Override REST/SSE base URL for a remote shioaji server.
# Leave unset when using the dev proxy or when deployed under /apps/<name>/.
# VITE_API_BASE=http://my-shioaji-server.local:8080

# Build-time public base path when deploying as a shioaji custom app.
# VITE_BASE=/apps/shioaji-pro-app/

# Optional: Google Analytics 4. Used only for app_open + app_heartbeat,
# so GA Realtime can show active users in the last 5/30 minutes.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Docker Deployment ────────────────────────────────────────────────
# 容器對外暴露之埠號（預設 5173）
# PORT=5173
# 後端 Shioaji 服務位址（預設連線至宿主機 8080）
# API_TARGET=http://host.docker.internal:8080

# ── 玉山證券 (E.SUN Securities) 交易設定 ──────────────────────────────
# 前端自動帶入之玉山帳戶（分公司代碼 9600 + 帳號 7 碼）
# VITE_ESUN_ACCOUNT=96001234567
# VITE_ESUN_BROKER_ID=9600
# VITE_ESUN_USERNAME=玉山證券

# Node.js SDK / 自動化環境專用（可指定 config.ini 或個別環境變數）
# ESUN_CONFIG_PATH=./config.ini
# ESUN_API_URL=https://esuntradingapi-simulation.esunsec.com.tw/api/v1
# ESUN_API_KEY=your_esun_api_key
# ESUN_API_SECRET=your_esun_api_secret
# ESUN_CERT_PATH=./certs/your_esun_cert.p12
# ESUN_CERT_PASS=your_cert_password
# ESUN_PASSWORD=your_trading_password
