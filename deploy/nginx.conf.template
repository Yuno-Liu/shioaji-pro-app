server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Docker 內建 DNS；ipv6=off 避免 host.docker.internal 解析出容器無法連線的
    # IPv6 位址（Network unreachable → /api 回 500/502）。upstream 以變數指定，
    # 讓 nginx 在請求時才解析，esun-bridge 尚未啟動也不會讓 nginx 開不起來。
    resolver 127.0.0.11 ipv6=off valid=30s;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # Static assets long-term caching
    location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|eot|ttf|svg)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA routing fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 玉山證券下單橋接服務（esun-bridge 容器）
    location /esun/ {
        set $esun_upstream ${ESUN_BRIDGE_TARGET};
        proxy_pass $esun_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
        # 下單請求不可自動重送
        proxy_next_upstream off;
    }

    # Proxy API & Server-Sent Events (SSE) to Shioaji Server
    location /api/ {
        set $api_upstream ${API_TARGET};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Disable buffering for Server-Sent Events (SSE) streaming
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection '';
        chunked_transfer_encoding on;

        # Long read/send timeout for continuous market quote streams
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
